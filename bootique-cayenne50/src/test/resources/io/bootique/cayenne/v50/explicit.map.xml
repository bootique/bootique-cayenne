<?xml version="1.0" encoding="utf-8"?>
<dataMap xmlns="http://cayenne.apache.org/schema/14/dataMap"
	 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	 xsi:schemaLocation="http://cayenne.apache.org/schema/14/dataMap https://cayenne.apache.org/schema/14/dataMap.xsd"
	 defaultPackage="io.bootique.cayenne.v50.cayenne">
	<dbEntity name="T1">
		<dbAttribute name="id" type="INTEGER" primaryKey="true" mandatory="true"/>
		<dbAttribute name="name" type="VARCHAR" length="100"/>
	</dbEntity>
	<dbEntity name="T2">
		<dbAttribute name="id" type="INTEGER" primaryKey="true" mandatory="true"/>
		<dbAttribute name="name" type="VARCHAR" length="100"/>
	</dbEntity>
	<objEntity name="T1" className="io.bootique.cayenne.v50.cayenne.T1" dbEntityName="T1">
		<objAttribute name="name" type="java.lang.String" dbAttributePath="name"/>
	</objEntity>
	<objEntity name="T2" className="io.bootique.cayenne.v50.cayenne.T2" dbEntityName="T2">
		<objAttribute name="name" type="java.lang.String" dbAttributePath="name"/>
	</objEntity>
</dataMap>
